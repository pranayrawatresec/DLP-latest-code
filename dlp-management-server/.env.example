# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://dlp:dlp_dev_password_change_me@127.0.0.1:5432/dlp

# --- Internal CA (Plane 2) ---
# Where CA key material is stored (default: ./ca, git-ignored).
# CA_DIR=./ca
# Primary DNS name agents will use to reach the mTLS listener; goes in the
# server certificate SAN. Defaults to the machine hostname.
# AGENT_SERVER_DNS=dlp-server.internal
# Optional: subject fields on the root CA certificate.
# CA_COMMON_NAME=DLP Internal CA
# CA_ORG=Acme Defence Ltd
# CA_COUNTRY=IN
# Optional: passphrase to encrypt the CA private key at rest (AES-256).
# If set, it must be present in the environment whenever the CA signs.
# CA_KEY_PASSPHRASE=change-me-and-store-in-a-secret-manager

# --- Encrypted blob store (protected documents) ---
# 256-bit master key for AES-256-GCM encryption of stored document blobs,
# as 64 hex characters. Required for document registration + the worker.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DLP_BLOB_MASTER_KEY=<64 hex chars — generate per install, keep in a secret manager>

# --- Encrypt-on-write (trusted destinations) ---
# Org Root Key: 256-bit root of the KEK hierarchy, as 64 hex characters.
# Wraps every classification KEK at rest (AES-256-GCM). Without it, key
# creation returns 503 "encryption not configured" — there is NO default key
# (fail secure). Dev-only home; moves to an HSM in the hardening phase.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DLP_ORG_ROOT_KEY=<64 hex chars — generate per install, keep in a secret manager>
