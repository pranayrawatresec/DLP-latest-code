/dlp-management-server/node_modules
/.claude-flow/
/dlp

# Compiled driver build output — regenerated by dlp-minifilter\build\build-driver.bat
# and deployed as the separately-signed release binary, never pulled from git.
# (Productionization P6: don't check compiled .obj/.sys into source control.)
/dlp-minifilter/build/out/*.obj
/dlp-minifilter/build/out/*.sys
/dlp-minifilter/build/out/*.exe
/dlp-minifilter/build/out/*.lib
/dlp-minifilter/build/out/*.exp
/dlp-minifilter/build/out/*.pdb
/dlp-minifilter/build/out/*.cat
/dlp-minifilter/build/out/*.nativecodeanalysis.xml
/dlp-minifilter/build/out/*.res
# Microsoft-signed packages downloaded from Partner Center. Release artefacts,
# archived per release outside the repo; build/submissions/*.txt records their
# hashes so provenance stays in git without the binaries.
/signed_from_microsoft/
# Attestation submission staging (tools/make-submission.ps1). The CAB and its
# makecab byproducts are per-release artefacts, not source. The Microsoft-signed
# package that comes back should be archived outside the repo, per release.
/dlp-minifilter/build/submission/
# makecab drops these beside wherever it is run; two stale copies from an Aug
# 2026 attempt ended up in the repo root.
/setup.inf
/setup.rpt
*.cab
# ML model artefacts — hundreds of MB each (final.pt ~800 MB, model/encoder.onnx
# ~270 MB), over GitHub's 100 MB limit and never source. Staged onto endpoints by
# scripts/stage-ml-model.ps1 from the release package.
/Document_classification/
/Document_classification_split_onnx/

# Per-directory tool state and Python bytecode.
.claude-flow/
__pycache__/

# Business documents kept beside the repo, not part of it.
/DLP-RFP.pdf
/All features Viyuh_SubTasks*.xlsx
/BROWSER-UPLOAD-FEATURE-AUDIT.pdf
